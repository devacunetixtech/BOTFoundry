{
  "name": "botfoundry",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "install:all": "npm install --prefix frontend --legacy-peer-deps && npm install --prefix backend --legacy-peer-deps && npm install --legacy-peer-deps",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:backend": "npm run dev --prefix backend",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build:frontend": "npm run build --prefix frontend --legacy-peer-deps",
    "compile:contracts": "cd contracts && forge build"
  },
  "dependencies": {
    "concurrently": "^8.2.2"
  }
}
